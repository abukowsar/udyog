# Copy to .env.local and fill in real values. .env.local is git-ignored.

# MongoDB connection string (Atlas or self-hosted)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority

# Optional — database name (default: udyog)
MONGODB_DB=udyog

# Secret key for the bank-branch admin dashboard at /admin (use a long random string)
ADMIN_KEY=change-me-to-a-long-random-string
